[{"itemNum":"2026","variation":"1","description":"2-6-4 Steam Locomotive","itemType":"Steam Locomotive","varDesc":"1948 early\n2-6-2\n\nENGINE\ndie cast shell painted black, with silver rubber stamped lettering\nwith wire railing along boiler\nwithout Magnetraction\nwith steel rimmed spoked drivers\nwith black pilot mounting plate\npilot casting unpainted\nthree position E unit\nlighted with headlight lens\nwith smoke\nTENDER\nmixed color plastic shell painted black with silver heat stamped lettering\nwith wire railing on rear deck\nwith whistle\nwith staple end trucks the rear one is operating\nSE0175/0176\n\nnote black pilot mounting plate","gauge":"O Gauge","yearProd":"1948","_era":"pw","_tab":"Lionel PW - Items","subType":"2-6-4","refLink":"https://cornucopiaoftoytrains.com/postwar-steam-no-637-no-2037-2-6-4/#2026"},{"itemNum":"2026","variation":"2","description":"2-6-4 Steam Locomotive","itemType":"Steam Locomotive","varDesc":"1948 – 1949\n2-6-2\n\nENGINE\ndie cast shell painted black, with silver rubber stamped lettering\nwith wire railing along boiler\nwithout Magnetraction\nwith steel rimmed spoked drivers\nwith shinny steel pilot mounting plate\npilot casting painted black\nthree position E unit\nlighted with headlight lens\nwith smoke\nTENDER\nmixed color plastic shell painted black with silver heat stamped lettering\nwith wire railing on rear deck\nwith whistle\nwith staple end trucks the rear one is operating\nSE0113/0114","gauge":"O Gauge","yearProd":"1948-1949","_era":"pw","_tab":"Lionel PW - Items","subType":"2-6-4","refLink":"https://cornucopiaoftoytrains.com/postwar-steam-no-637-no-2037-2-6-4/#2026"},{"itemNum":"2026","variation":"3","description":"2-6-4 Steam Locomotive","itemType":"Steam Locomotive","varDesc":"1951 – 1952\n2-6-4\n\nENGINE\ndie cast shell painted black, with silver rubber stamped lettering\nwithout wire railing along boiler\nwithout Magnetraction\nwithout steel rimmed spoked drivers, with spoked drivers\nwith shinny steel pilot mounting plate\nunpainted pilot casting\nthree position E unit\nlighted with headlight lens\nwith smoke\nTENDER\nmixed color plastic shell painted black with silver heat stamped lettering\nwithout wire railing on rear deck\nwith whistle\nwith staple end trucks the rear one is operating\nSE0115/0116\n\nUNUSUAL 2026 FROM SET 1463WS – 1952\n\nThis 2026 is identical to the 2-6-4 shown above and is a one owner item I obtained in 1952 new as my first Lionel train. Note the two “5’s” stamped on the underside. To my knowledge, this engine was never out for service and my 5 year old childhood memory is that it was always there. More information is requested.\n\nCourtesy of “The Leverich Collection”","gauge":"O Gauge","yearProd":"1951-1952","_era":"pw","_tab":"Lionel PW - Items","subType":"2-6-4","refLink":"https://cornucopiaoftoytrains.com/postwar-steam-no-637-no-2037-2-6-4/#2026"},{"itemNum":"2026-58","variation":"1","description":"18V Clear Lamp","itemType":"Accessory","varDesc":"no variation","yearProd":"1948 - 1953","_era":"pw","_tab":"Lionel PW - Items","subType":"Bulb","refLink":"https://cornucopiaoftoytrains.com/bulbs-master-cartons/#BMC202658"},{"itemNum":"2026-58","variation":"2","description":"18V Clear Lamp","itemType":"Accessory","varDesc":"Master carton of twelve","_era":"pw","_tab":"Lionel PW - Items","subType":"Bulb Carton","refLink":"https://cornucopiaoftoytrains.com/bulbs-master-cartons/#BMC202658"},{"itemNum":"22","variation":"1","description":"Remote Control Switches","itemType":"Track","varDesc":"no variation","yearProd":"1945-1966","_era":"pw","_tab":"Lionel PW - Items","subType":"Switch"},{"itemNum":"25","variation":"1","description":"Track Bumper","itemType":"Accessory","varDesc":"no variation","yearProd":"1946-1947","_era":"pw","_tab":"Lionel PW - Items","subType":"Bumper","refLink":"https://cornucopiaoftoytrains.com/postwar-tenders-small-streamlined/"},{"itemNum":"30","variation":"1","description":"Water Tank","itemType":"Accessory","varDesc":"Type I, w